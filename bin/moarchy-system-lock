#!/bin/bash
# Lock the phone: the session lock, then the panel and the touchscreen off.
#
# The lock is the shell's moarchy.lock plugin, an ext-session-lock client that
# draws its own PIN keypad, because under that protocol the on-screen keyboard
# is hidden like every other surface. Locking is therefore always safe to do:
# whatever locked the phone, the keypad that opens it is on the lock surface.
#
# Then moarchy-screen lock, so a phone in a pocket shows nothing and its
# touchscreen cannot type PIN attempts. The power button lights it again with
# the keypad live.
#
# Callers: omarchy-system-lock (upstream's binding, its idle service and its
# menu), Settings > Power > Lock and the idle timeout (moarchy-idle-lock). The
# power button is not one: its own press already blanked the panel, so
# moarchy-power-press asks the plugin directly.
#
# With no shell to answer, this can only blank, and says so: a panel that went
# dark without a lock behind it is worth knowing about.
BIN="$(dirname "$(readlink -f "$0")")"

if ! out=$(omarchy-shell moarchy-lock lock 2>&1) || [[ $out != ok ]]; then
  echo "${0##*/}: the shell did not take the lock (${out:-no answer}); blanking only" >&2
fi

exec "$BIN/moarchy-screen" lock
