#!/bin/bash
# moarchy-screen -- what the power button does on the phone.
#
# "Lock" here means: blank the panel and stop the touchscreen from producing
# events. It does NOT take the session lock; moarchy.lock does that, and
# moarchy-system-lock and moarchy-power-press call both.
#
# A dead touchscreen behind a dark panel gives the thing you actually want from
# a pocket -- nothing sees the screen, nothing reacts to it, nothing types PIN
# attempts into the lock screen -- and the hardware power button is outside
# that state, so it can always undo it.
#
# The lock state lives in a flag file rather than being read back from the
# output's power flag, because swayidle blanks the same output on its own idle
# timeout. Keying off the panel would make the button's meaning depend on
# whether the idle timer had fired.
#
# Every compositor call goes through `hyprctl dispatch`/`eval` with Lua, not the
# legacy string form: under a .lua config `hyprctl dispatch dpms off` is a Lua
# syntax error and `hyprctl keyword` is refused outright.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/moarchy"
FLAG="$STATE_DIR/screen-locked"

dpms() {
  hyprctl dispatch "hl.dsp.dpms({ action = \"$1\" })" >/dev/null
}

# The Goodix panel is listed under `touch` in `hyprctl devices -j`, by name.
touch_devices() {
  hyprctl devices -j | jq -r '.touch[]? | .name' | sort -u
}

# true/false, because `enabled` is a device property rather than sway's
# enabled/disabled event mode.
set_touch() {
  local id
  while read -r id; do
    [[ -n $id ]] && hyprctl eval "hl.device({ name = \"$id\", enabled = $1 })" >/dev/null
  done < <(touch_devices)
}

lock() {
  mkdir -p "$STATE_DIR"
  : >"$FLAG"
  set_touch false               # before the blank, so the dark panel is already deaf
  dpms off
}

unlock() {
  rm -f "$FLAG"
  dpms on
  set_touch true                # after the panel is back, so the first tap is seen
}

case "${1:-toggle}" in
  lock)   lock ;;
  unlock) unlock ;;
  toggle) if [[ -e $FLAG ]]; then unlock; else lock; fi ;;
  # Dark panel, live touchscreen, no flag. What a plain "turn the display off"
  # means -- it is not a lock, and routing it through lock() would set the flag
  # and then `wake` would refuse to undo it, a dark panel nothing but the power
  # button can light (docs/refactor.md D1, D2). The idle timeout used to come
  # here too; it locks now, with a keypad to come back to (D3, amended).
  blank)  dpms off ;;
  # swayidle's resume hook, and the one way back on. Any input wakes the panel,
  # but while we are locked the only input that should is the power button,
  # which unlocks in its own right -- so resume must not light the screen
  # behind our back. Every caller that means "display on" comes here rather
  # than to hyprctl, so the flag is the single gate (D1).
  wake)   [[ -e $FLAG ]] || dpms on ;;
  *)      echo "usage: ${0##*/} [lock|unlock|toggle|blank|wake]" >&2; exit 1 ;;
esac
