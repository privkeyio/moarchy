#!/bin/bash
# Shim. Upstream's lock is its own shell plugin, which this phone leaves inert
# (it has no /etc/pam.d/omarchy-lock-password to authenticate against).
# moarchy-system-lock takes the session lock through moarchy.lock instead,
# whose keypad is drawn on the lock surface, so upstream's binding, its idle
# service and its menu all lock the phone the way the power button does.
exec moarchy-system-lock "$@"
