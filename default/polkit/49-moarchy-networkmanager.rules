// Changing a saved network asks for the PIN (docs/structure.md I8).
//
// NetworkManager's own org.freedesktop.NetworkManager.rules answers yes to
// wheel in a local session for settings.modify.system, and its policy answers
// yes to an active session for settings.modify.own. Either lets any app the
// user runs add, change or delete a connection, so point DNS, proxy and routes
// elsewhere, and read every saved secret: NetworkManager returns secrets to
// whoever holds the same permission. polkit runs rules in file name order
// across its directories and the first answer wins, so this one, sorting
// first, decides.
//
// network-control too, which NetworkManager's policy answers yes to an active
// session: it brings up or takes down any connection, and Device.Reapply
// rewrites the live connection's DNS, routes and addresses without saving
// them.
//
// _KEEP: the process that gave the PIN keeps it for polkit's five minutes, for
// that one action, and another process asks for its own. So switching to a
// saved network or forgetting one asks once, and the first join of a new one
// asks twice: network-control to bring it up, then settings.modify.system to
// save it (measured, docs/structure.md I8). Autoconnect is NetworkManager's
// own and asks nothing, and the radios and scanning (enable-disable-*,
// wifi.scan) still ask nothing.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
      action.id == "org.freedesktop.NetworkManager.settings.modify.own" ||
      action.id == "org.freedesktop.NetworkManager.network-control") {
    return polkit.Result.AUTH_ADMIN_KEEP;
  }
});
